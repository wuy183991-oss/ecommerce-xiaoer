# 复制为 .env 后按需修改
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# 异步模式
DATABASE_URL=mysql+asyncmy://root:your_password@127.0.0.1:3306/customer_service?charset=utf8mb4

# 同步模式
DATABASE_URL_SYNC=mysql+pymysql://root:your_password@127.0.0.1:3306/customer_service?charset=utf8mb4

APP_HOST=127.0.0.1
APP_PORT=18082

